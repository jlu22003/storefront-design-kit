{
  "$description": "Color roles, elevation and media treatment for the increased-contrast light mode. Every mode file defines the same tokens (COL-07).",
  "color": {
    "$type": "color",
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#FFFFFF"
      },
      "$description": "Base page background.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "surface"
        }
      }
    },
    "bg-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9216, 0.9216, 0.9373],
        "hex": "#EBEBEF"
      },
      "$description": "Secondary background for grouped or inset areas.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "surface"
        }
      }
    },
    "bg-elevated": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#FFFFFF"
      },
      "$description": "Sheets, popovers and dialogs. Lighter than bg in dark mode (DRK-02).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "surface"
        }
      }
    },
    "bg-grouped": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9216, 0.9216, 0.9373],
        "hex": "#EBEBEF"
      },
      "$description": "Background behind grouped lists and cards.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "surface"
        }
      }
    },
    "label": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      },
      "$description": "Primary text.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "label-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1804, 0.1804, 0.2],
        "hex": "#2E2E33"
      },
      "$description": "Secondary text.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "label-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2471, 0.2471, 0.2706],
        "hex": "#3F3F45"
      },
      "$description": "Tertiary text.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "label-disabled": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4784, 0.4784, 0.502],
        "hex": "#7A7A80"
      },
      "$description": "Disabled text. Exempt from contrast minimums (WCAG 1.4.3), so never use it for live content.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "disabled"
        }
      }
    },
    "placeholder": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2902, 0.2902, 0.3137],
        "hex": "#4A4A50"
      },
      "$description": "Placeholder text in fields. A hint only, never the label (FRM-01).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "separator": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5412, 0.5412, 0.5725],
        "hex": "#8A8A92"
      },
      "$description": "Decorative divider. Never the only boundary of a control (COL-03).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "decorative"
        }
      }
    },
    "separator-opaque": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2902, 0.2902, 0.3137],
        "hex": "#4A4A50"
      },
      "$description": "Control borders, such as text fields (COL-03).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "boundary"
        }
      }
    },
    "border-elevated": {
      "$value": "{color.separator-opaque}",
      "$description": "Hairline around elevated surfaces where shadows are off (MAT-06).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "decorative"
        }
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.2784, 0.6706],
        "hex": "#0047AB"
      },
      "$description": "Interactive and primary-action color (COL-05). Also the prominent button fill.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "link": {
      "$value": "{color.accent}",
      "$description": "Links.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "focus": {
      "$value": "{color.accent}",
      "$description": "Focus ring (ACC-09).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "boundary"
        }
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#FFFFFF"
      },
      "$description": "Text and icons on an accent fill.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "on-accent"
        }
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6275, 0, 0.1255],
        "hex": "#A00020"
      },
      "$description": "Errors and destructive actions. Pair with text or an icon (COL-04).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "sale": {
      "$value": "{color.danger}",
      "$description": "Sale prices. Pair with text such as \"Sale\" (COL-04).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0431, 0.3686, 0.1451],
        "hex": "#0B5E25"
      },
      "$description": "Success and in-stock state.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4196, 0.2471, 0],
        "hex": "#6B3F00"
      },
      "$description": "Warnings and low stock, as text.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "text"
        }
      }
    },
    "scrim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.45,
        "hex": "#000000"
      },
      "$description": "Backdrop behind modal sheets and dialogs.",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "overlay"
        }
      }
    },
    "overlay-media": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.35,
        "hex": "#000000"
      },
      "$description": "Scrim over bright media under clear material (MAT-05).",
      "$extensions": {
        "io.github.jlu22003.sdk": {
          "usage": "overlay"
        }
      }
    }
  },
  "shadow": {
    "1": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.12,
          "hex": "#000000"
        },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Elevation shadows, from 1 (low) to 3 (high)."
    },
    "2": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.16,
          "hex": "#000000"
        },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 12, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "3": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.2,
          "hex": "#000000"
        },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 12, "unit": "px" },
        "blur": { "value": 32, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "$type": "shadow"
  },
  "media": {
    "$type": "number",
    "brightness": {
      "$value": 1,
      "$description": "Brightness filter for product images, softened in dark modes (DRK-04)."
    }
  }
}
