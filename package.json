{
  "name": "storefront-design-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Responsive design system, layout primitives, and standards test suite for Shopify themes and client sites",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"scripts/test/*.test.mjs\" \"tests/**/*.test.mjs\"",
    "catalog:docs": "node scripts/catalog-docs.mjs",
    "catalog:docs:check": "node scripts/catalog-docs.mjs --check",
    "catalog:check": "node scripts/catalog-check.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "lint:css": "stylelint \"**/*.css\"",
    "dev": "node playground/server.mjs",
    "sketch": "node playground/new-sketch.mjs",
    "bookmarklet": "node scripts/build-bookmarklet.mjs",
    "test:e2e": "playwright test",
    "test:e2e:docker": "node scripts/playwright-docker.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "postcss": "8.5.32",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
